---
import { getCollection } from "astro:content";
import TechTag from "./TechTag.astro";

const contactLinks = await getCollection("contactlinks");
---

<footer>
  <div class="contact">
    <h3>Contact</h3>
    <div class="link-container">
      {
        contactLinks.map(({ data: contact }) => (
          <a
            class="contact-link"
            href={
              contact?.link
                ? contact.link
                : contact?.mail
                  ? `mailto:${contact.mail}`
                  : null
            }
          >
            <img src={contact.image} alt="" />
            {contact.text}
          </a>
        ))
      }
    </div>
  </div>
  <div class="technos">
    <p>Site créé avec <TechTag slug="astro" size={16} /></p>
    <p class="detail">- Encore en construction -</p>
    <p>© 2025 Florian Amiot - Tous droits réservés</p>
    <a href="./termsofuse">Mentions Légales</a>
  </div>
</footer>
<style>
  footer {
    background-color: var(--secondary-color);
    padding-block: 1rem;
    padding-inline: clamp(2rem, 10vw, 500px);
    display: flex;
    justify-content: space-between;
  }
  footer * {
    color: white;
  }
  .link-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .contact-link {
    display: flex;
    align-items: center;
  }
  .contact-link img {
    margin-right: 0.2rem;
    height: 30px;
  }
  footer a {
    font-weight: 700;
  }
  .technos {
    text-align: end;
    display: flex;
    flex-direction: column;
    justify-content: end;
  }
  .detail {
    opacity: 60%;
    font-style: italic;
  }
</style>
