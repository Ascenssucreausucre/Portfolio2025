<style>
  #design img:hover {
    cursor: pointer;
  }
  .text-container {
    max-width: 800px;
    margin-inline: auto;
    padding-inline: clamp(35px, 10vw - 2rem, 50px);
    text-align: justify;
  }
  .text-container a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 900;
  }
  .details {
    opacity: 75%;
    font-style: italic;
  }
  .assets {
    margin-block: 1rem;
    padding: 1rem clamp(10px, 10vw - 2rem, 200px);
    background: linear-gradient(
      110deg,
      var(--primary-color) 0%,
      var(--secondary-color) 100%
    );
    color: white;
  }
  .assets .title {
    color: white;
  }
</style>
