---
interface Props {
  title: string;
  images: Array<string>;
  description: string;
  date: Date;
}

const { title, description, images } = Astro.props as Props;
---

<article
  class="design-item"
  data-title={title}
  data-images={JSON.stringify(images)}
  data-description={description}
>
  <div class="folder-icon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"
      ></path>
    </svg>
  </div>
  <h3 class="folder-title">{title}</h3>
</article>

<script>
  // Removed old script for arrows
</script>

<style>
  .design-item {
    /* background-color: var(--background-color); */
    color: black;
    width: clamp(150px, 20%, 200px);
    border-radius: 8px;
    filter: drop-shadow(0 0 10px rgba(0, 0, 0, 0.2));
    margin-block: 1rem;
    cursor: pointer;
    transition: transform 0.2s;
    overflow: hidden;
    align-items: center;
    padding: 1rem;
    text-align: center;
  }
  .design-item:hover {
    transform: scale(1.1);
  }
  .folder-icon {
    width: 64px;
    height: 64px;
    color: var(--background-color);
    margin-bottom: 0.5rem;
    margin-inline: auto;
  }
  .folder-icon svg {
    width: 100%;
    height: 100%;
  }
  .folder-title {
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    word-wrap: break-word;
    color: var(--background-color);
  }
  @media screen and (max-width: 700px) {
    .design-item {
      width: clamp(120px, 30%, 150px);
    }
    .design-item:nth-child(odd) {
      margin-left: unset;
    }
  }
</style>
